# Supabase: publishable key is safe to expose; service key is SERVER ONLY.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_KEY

# Optional AI estimation. Manual meal entry works without it.
OPENAI_API_KEY=
OPENAI_MEAL_MODEL=gpt-4.1-mini

# Optional Slack input (all must be configured before enabling events).
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_WORKSPACE_ID=
SLACK_USER_ID=
APP_OWNER_EMAIL=

# Optional Oura OAuth integration. Callback must match the registered URL exactly.
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
# Generate 32 random bytes, encoded as base64. Server only; keep stable after linking.
OURA_TOKEN_ENCRYPTION_KEY=
CALTRACK_ORIGIN=https://caltrack-mvp-haaanco.vercel.app

# Withings OAuth (server only; use a separate random 32-byte base64 key)
WITHINGS_CLIENT_ID=
WITHINGS_CLIENT_SECRET=
WITHINGS_TOKEN_ENCRYPTION_KEY=

# Google Health OAuth (server only)
GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=
GOOGLE_HEALTH_TOKEN_ENCRYPTION_KEY=
